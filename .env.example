# 이 파일을 복사해 .env를 만들고 값을 채우세요. (cp .env.example .env)
# .env는 깃에 올라가지 않습니다. 실제 비밀번호는 .env에만 적으세요.
# 비밀번호는 DB를 처음 띄울 때(docker compose up) 한 번만 적용됩니다.

POSTGRES_DB=pentakill
POSTGRES_USER=psql
POSTGRES_PASSWORD=

SMTP_HOST=사용할_SMTP_호스트
SMTP_PORT=587
SMTP_USERNAME=실제_SMTP_계정
SMTP_PASSWORD=실제_SMTP_비밀번호
SMTP_FROM_ADDRESS=발송이_허용된_이메일주소

EMAIL_VERIFICATION_HMAC_SECRET=생성한_Base64_비밀키